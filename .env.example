# =============================================================
# InvestAid - API Configuration
# =============================================================
# 1. Opret gratis konto på https://alpaca.markets
# 2. Gå til Paper Trading -> API Keys
# 3. Kopier denne fil til .env og udfyld dine nøgler

# Alpaca API Keys (Paper Trading)
ALPACA_API_KEY=PKxxxxxxxxxxxxxxxxxxxxxxxx
ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sæt til true KUN når du er klar til rigtig handel
# Paper trading = simuleret handel med ægte markedsdata
LIVE_TRADING=false
