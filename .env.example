# =============================================================
# InvestAid - API Konfiguration
# =============================================================
# 1. Kopier denne fil til .env:  cp .env.example .env
# 2. Udfyld dine nøgler nedenfor
# 3. .env må ALDRIG committes til git (den er i .gitignore)

# ------------------------------------------------------------------
# Alpaca Paper Trading API (PÅKRÆVET)
# Opret gratis konto på https://alpaca.markets
# Gå til Paper Trading → API Keys → Generer nøgler
# ------------------------------------------------------------------
ALPACA_API_KEY=PKxxxxxxxxxxxxxxxxxxxxxxxx
ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sæt til true KUN når du er klar til rigtig handel med rigtige penge
# Paper trading = simuleret handel med ægte markedsdata ($100.000 fiktivt)
LIVE_TRADING=false

# ------------------------------------------------------------------
# E-mail Notifikationer (VALGFRIT men anbefalet)
# Gmail-vejledning:
#   1. Slå 2-faktor-godkendelse til på din Google-konto
#   2. Gå til myaccount.google.com → Sikkerhed → App-adgangskoder
#   3. Opret en adgangskode til "Mail" og indsæt den nedenfor
# ------------------------------------------------------------------
EMAIL_SENDER=din@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_RECIPIENT=din@gmail.com

# SMTP (default: Gmail — ændr kun hvis du bruger anden udbyder)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# IMAP til kill-switch (default: Gmail)
EMAIL_IMAP_HOST=imap.gmail.com

# Kodeord til kill-switch (svar på alarm-mail med dette ord for at stoppe handel)
EMAIL_KILL_WORD=STOP

# Hvor tit tjekkes indbakken for kill-switch-svar (sekunder, default: 60)
EMAIL_KILL_SWITCH_INTERVAL=60
